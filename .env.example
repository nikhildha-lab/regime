# Market Pulse – copy to .env and fill in. Never commit .env.
# Absolute paths to the helper services (defaults are the original Mac layout under ~/Documents).
MP_DHAN_DIR=/opt/market-pulse/services/dhan
MP_NIFTY_TRACKER_DIR=/opt/market-pulse/services/nifty-tracker
MP_METALS_DIR=/opt/market-pulse/services/metals-tracker

# Server time zone – the desk works in IST.
TZ=Asia/Kolkata

# Broker secrets do NOT go here. They live in:
#   services/dhan/.env                 DHAN_CLIENT_ID=, DHAN_ACCESS_TOKEN=   (order-flow engine)
#   services/nifty-tracker/.dhan_token written by `python -m src.dhan_auth` (owner logs in; renewed by dhan_keepalive.sh)
#   services/nifty-tracker/.env        see services/nifty-tracker/.env.example (Telegram alerts optional)
# In production keep them in a secrets manager and mount them read-only.
