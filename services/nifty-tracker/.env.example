# ---- Zerodha Kite Connect ----
# Create an app at https://developers.kite.trade/ to get these.
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# The access token is generated daily by the login flow (python -m src.kite_auth).
# It is written to .kite_token automatically; you normally don't set it by hand.
KITE_ACCESS_TOKEN=

# ---- Telegram alerts (optional but recommended) ----
# 1. Message @BotFather on Telegram -> /newbot -> copy the token.
# 2. Message your new bot once, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Runtime ----
# live | sim   (sim = synthetic replay so you can test when market is closed)
RUN_MODE=sim
